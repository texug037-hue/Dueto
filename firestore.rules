rules_version = '2';

// ============================================================
// REGRAS DE SEGURANÇA DO DUETO
// Cole isso em: Firebase Console -> Firestore Database -> Regras
// ============================================================
// Princípio: NINGUÉM lê ou escreve nada sem estar logado, e só os
// dois números autorizados conseguem logar (isso é reforçado tanto
// aqui quanto no Firebase Authentication, em duas camadas).
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Lista de UIDs autorizados. Depois do primeiro login de cada um,
    // pegue o UID no Firebase Console (Authentication -> Users) e
    // troque os placeholders abaixo.
    function ehUsuarioAutorizado() {
      return request.auth != null &&
        request.auth.uid in ['UID_DO_FABRICIO', 'UID_DA_HOSANA'];
    }

    match /contas/{contaId} {
      allow read: if ehUsuarioAutorizado();
      allow create: if ehUsuarioAutorizado()
        && request.resource.data.keys().hasAll(['categoria','nome','valor','vencimento','lancadoPor'])
        && request.resource.data.valor is number
        && request.resource.data.valor > 0
        && request.resource.data.lancadoPor == request.auth.token.phone_number;
      allow update: if ehUsuarioAutorizado();
      allow delete: if ehUsuarioAutorizado();
    }

    match /backups/{doc} {
      allow read, write: if ehUsuarioAutorizado();
    }

    // Bloqueia qualquer coisa fora das coleções acima por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
