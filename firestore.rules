rules_version = '2';

// ============================================================
// REGRAS DE SEGURANÇA DO DUETO
// Cole isso em: Firebase Console -> Firestore Database -> Regras -> Publicar
// ============================================================
// Por enquanto libera pra qualquer usuário autenticado (só Fabrício e
// Hosana conseguem autenticar, porque só os números deles fazem login).
// Depois dá pra travar ainda mais checando o UID exato de cada um.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    match /contas/{contaId} {
      allow read, write: if request.auth != null;
    }

    match /historico/{id} {
      allow read, write: if request.auth != null;
    }

    match /backups/{doc} {
      allow read, write: if request.auth != null;
    }

    // Bloqueia qualquer coisa fora das coleções acima por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
